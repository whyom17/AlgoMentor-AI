# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://algomentor:algomentor@localhost:5432/algomentor
DATABASE_URL_SYNC=postgresql://algomentor:algomentor@localhost:5432/algomentor

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Judge0 (self-hosted via docker-compose) ─────────────────────────────────
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=                # leave blank for open CE install

# ─── LLM providers ───────────────────────────────────────────────────────────
# Level 1-2 hints → cheap model (gpt-4o-mini / claude-haiku)
# Level 3-4 hints + review → frontier model (gpt-4o / claude-3-5-sonnet)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Which provider to use for cheap/frontier tiers:
#   "openai" | "anthropic"
CHEAP_LLM_PROVIDER=openai
CHEAP_LLM_MODEL=gpt-4o-mini
FRONTIER_LLM_PROVIDER=openai
FRONTIER_LLM_MODEL=gpt-4o

# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
# Leave blank to use local JWT stub during development
CLERK_SECRET_KEY=
CLERK_JWKS_URL=https://api.clerk.dev/v1/jwks
JWT_SECRET_KEY=dev-local-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080   # 7 days
